APP_NAME="Zul Tennis Clinic Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ztcms
DB_USERNAME=ztcms
DB_PASSWORD=ztcms

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=ztcms_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@zultennisclinic.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage (MinIO in local/dev)
AWS_ACCESS_KEY_ID=ztcms_minio
AWS_SECRET_ACCESS_KEY=change-me-minio-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ztcms-media
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9010/ztcms-media
AWS_USE_PATH_STYLE_ENDPOINT=true

# Shared secret for verifying POST /api/v1/webhooks/payment-gateway signatures
# (HMAC-SHA256 over the raw body, header X-Signature). No real gateway is
# integrated yet — this just secures the generic webhook contract.
PAYMENT_GATEWAY_WEBHOOK_SECRET=change-me-webhook-secret

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SPA_URL=http://localhost:3000

VITE_APP_NAME="${APP_NAME}"
