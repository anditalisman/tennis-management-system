# --- Shared / infra-level settings for docker-compose ---
COMPOSE_PROJECT_NAME=ztcms

APP_PORT=8090
FRONTEND_PORT=3000

# --- MySQL ---
DB_DATABASE=ztcms
DB_USERNAME=ztcms
DB_PASSWORD=ztcms
DB_ROOT_PASSWORD=ztcms_root

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=ztcms_minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_BUCKET=ztcms-media
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
# Public URL clients use to reach MinIO (browser-facing, e.g. gallery images)
AWS_URL=http://localhost:9010/ztcms-media

# --- Laravel app (backend/) — forwarded straight into the app/queue/
# scheduler containers via docker-compose's environment:, so this file
# (or Dokploy's Environment Variables tab) is the ONLY place these need to
# be set. No backend/.env required on the deploy host. ---
APP_NAME=Zul Tennis Clinic Management System
# production checklist (see docs/deployment.md §1) before going live:
APP_ENV=local
# Generate with: docker compose exec app php artisan key:generate --show
# Required — Laravel refuses to boot without it (fails fast, not silently).
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
LOG_LEVEL=debug

# Dev default "log" writes emails to storage/logs/laravel.log instead of
# sending them. Switch to "smtp" (see mailserver below) or a real provider
# for staging/prod.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=mailserver
MAIL_PORT=587
MAIL_USERNAME=no-reply@zultennis.my.id
# Must match the password set for this mailbox on the mailserver container:
#   docker compose exec mailserver setup email add no-reply@zultennis.my.id 'this-value'
# (docker-mailserver always requires SMTP AUTH once a client offers a
# username — PERMIT_DOCKER=network only trusts unauthenticated senders that
# don't attempt AUTH at all, so a mismatched password still hard-fails here.)
MAIL_PASSWORD=change-me-mail-secret
MAIL_FROM_ADDRESS=no-reply@zultennis.my.id
MAIL_FROM_NAME="${APP_NAME}"
# Only for the self-hosted mailserver's self-signed cert (SSL_TYPE=self-signed
# below) — never enable this against a real external SMTP provider.
MAIL_ALLOW_SELF_SIGNED=true

# --- Self-hosted mail server + webmail (docker-mailserver + Roundcube) ---
# FQDN this server identifies itself as in SMTP EHLO/HELO and TLS certs.
# Must match a real DNS A record pointing at this host, and match the MX
# record's target — MX/SPF/DKIM/DMARC/PTR must all be set up for mail sent
# from here to be accepted instead of rejected/spam-filtered by other
# providers (see docs/deployment.md).
MAIL_HOSTNAME=smtp.zultennis.my.id
# Public hostname for the Roundcube webmail UI (needs its own DNS A record).
MAIL_WEBMAIL_DOMAIN=mail.zultennis.my.id
# Host ports docker-mailserver publishes. 25 (SMTP, receiving mail from
# other servers) is the one most likely to be blocked outbound/inbound by
# VPS providers by default — confirm with your provider if mail delivery
# to this server seems to silently fail.
MAIL_SMTP_PORT=25
MAIL_SUBMISSION_PORT=587
MAIL_SUBMISSIONS_PORT=465
MAIL_IMAPS_PORT=993

# Frontend's public domain — update both for production
SANCTUM_STATEFUL_DOMAINS=localhost:8088
SPA_URL=http://localhost:8088
PAYMENT_GATEWAY_WEBHOOK_SECRET=change-me-webhook-secret

# --- WhatsApp OTP (registration verification) — self-hosted OpenWA gateway ---
# "log" (default) writes the OTP to notification_logs without sending it —
# safe for dev/first deploy. Switch to "openwa" only once a WhatsApp session
# is paired on the gateway below and OPENWA_API_KEY/SESSION_ID are filled in.
WHATSAPP_PROVIDER=log
OPENWA_BASE_URL=https://owa.app-pdamgm.xyz
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_TIMEOUT=15
