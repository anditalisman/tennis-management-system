# --- Shared / infra-level settings for docker-compose ---
COMPOSE_PROJECT_NAME=ztcms

APP_PORT=8090
FRONTEND_PORT=3000

# --- MySQL --- (must match backend/.env DB_* values)
DB_DATABASE=ztcms
DB_USERNAME=ztcms
DB_PASSWORD=ztcms
DB_ROOT_PASSWORD=ztcms_root

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=ztcms_minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_BUCKET=ztcms-media
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
